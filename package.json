{
  "name": "pi-capsule-agents",
  "version": "1.1.0",
  "description": "Capability-scoped, credential-free main and child agent capsules with explicit artifact delivery.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "agents", "isolation", "capabilities"],
  "files": ["extensions", "capsule/*.py", "pyproject.toml", "Dockerfile", ".dockerignore", "examples", "README.md", "docs", "tests/*.py", "tests/*.mjs", "scripts", "LICENSE"],
  "pi": {"extensions": ["./extensions/index.ts"]},
  "scripts": {
    "test": "python -m unittest discover -s tests -v && node --test tests/extension.test.mjs",
    "demo": "python -m capsule demo",
    "mcp": "python -m capsule mcp",
    "build:image": "docker build -t pi-capsule-agents:1.0.0 .",
    "pack:source": "python scripts/package.py"
  },
  "peerDependencies": {"@earendil-works/pi-coding-agent": ">=0.87.1"}
}
